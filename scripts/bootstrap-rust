#!/bin/sh
set -eu
case "$(uname -sm)" in
    'Darwin arm64') platform=aarch64-apple-darwin ;;
    'Darwin x86_64') platform=x86_64-apple-darwin ;;
    'Linux x86_64') platform=x86_64-unknown-linux-gnu ;;
    'Linux aarch64') platform=aarch64-unknown-linux-gnu ;;
    *) echo 'Install Rust from https://rustup.rs for this platform.' >&2; exit 1 ;;
esac
installer=$(mktemp "${TMPDIR:-/tmp}/level-editor-rustup-init.XXXXXX")
trap 'rm -f "$installer"' EXIT
curl --proto '=https' --tlsv1.2 -fL "https://static.rust-lang.org/rustup/dist/$platform/rustup-init" -o "$installer"
chmod +x "$installer"
"$installer" -y --profile minimal --component rustfmt,clippy
