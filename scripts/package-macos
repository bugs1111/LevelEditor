#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"
case "$#" in
    0)
        scripts/cargo build --release --locked
        binary="$project_dir/target/release/ldtk-rs"
        bundle="$project_dir/dist/LevelEditor.app"
        ;;
    2)
        binary="$1"
        bundle="$2"
        ;;
    *)
        printf 'Usage: %s [binary output.app]\n' "$0" >&2
        exit 2
        ;;
esac
bundle_parent=$(dirname -- "$bundle")
mkdir -p "$bundle_parent"
staging_dir=$(mktemp -d "$bundle_parent/.leveleditor-app.XXXXXX")
staged_bundle="$staging_dir/LevelEditor.app"
previous_bundle="$staging_dir/previous.app"
cleanup() {
    if [ -e "$previous_bundle" ] && [ ! -e "$bundle" ]; then
        if ! mv "$previous_bundle" "$bundle"; then
            printf 'Previous bundle retained at %s\n' "$previous_bundle" >&2
            return 1
        fi
    fi
    rm -rf "$staging_dir"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
mkdir -p "$staged_bundle/Contents/MacOS" "$staged_bundle/Contents/Resources/examples"
cp "$binary" "$staged_bundle/Contents/MacOS/ldtk-rs"
cp -R examples/original "$staged_bundle/Contents/Resources/examples/"
cp -R assets "$staged_bundle/Contents/Resources/"
cp assets/LevelEditor.icns "$staged_bundle/Contents/Resources/LevelEditor.icns"
cp assets/project.icns "$staged_bundle/Contents/Resources/project.icns"
cp LICENSE THIRD_PARTY_NOTICES.md "$staged_bundle/Contents/Resources/"
cp scripts/ldtk-rs-install.json "$staged_bundle/Contents/Resources/ldtk-rs-install.json"
cp scripts/macos-info.plist "$staged_bundle/Contents/Info.plist"
app_version=$(python3 -c 'import pathlib,re; print(re.search(r"^version = \"([^\"]+)\"",pathlib.Path("Cargo.toml").read_text(),re.M)[1])')
plutil -replace CFBundleShortVersionString -string "$app_version" "$staged_bundle/Contents/Info.plist"
plutil -replace CFBundleVersion -string "$app_version" "$staged_bundle/Contents/Info.plist"
plutil -lint "$staged_bundle/Contents/Info.plist"
codesign --force --deep --sign - "$staged_bundle"
codesign --verify --deep --strict "$staged_bundle"
if [ -e "$bundle" ]; then
    mv "$bundle" "$previous_bundle"
fi
mv "$staged_bundle" "$bundle"
printf '%s\n' "$bundle"
